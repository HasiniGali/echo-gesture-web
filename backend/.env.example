# Copy to .env only for local use. Never commit real credentials.
ECHOGESTURE_DATABASE_PATH=./data/echogesture.sqlite3
ECHOGESTURE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ECHOGESTURE_MODEL_PATH=
ECHOGESTURE_VOCABULARY_PATH=
# Dataset tensors verified against the original full_keypoints Cell 57 contract.
ECHOGESTURE_DATASET_PREPROCESSING_VERIFIED=false
# Keep false until browser landmark extraction is implemented and parity-tested.
ECHOGESTURE_INFERENCE_PREPROCESSING_VERIFIED=false
# Legacy alias; the new inference-specific variable takes precedence.
ECHOGESTURE_PREPROCESSING_VERIFIED=false
ECHOGESTURE_REJECTION_THRESHOLD=0.60
GOOGLE_TRANSLATE_API_KEY=
ECHOGESTURE_MANIFEST_DIR=
ECHOGESTURE_FEATURE_DIR=
